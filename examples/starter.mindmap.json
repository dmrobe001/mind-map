    "n_d175d74cb33631b8": {
      "id": "n_d175d74cb33631b8",
      "title": "Node contents",
      "summary": "Markdown, links, code, files, LaTeX.",
      "content": [
        {
          "id": "b_f881c4a92f7fc9ab",
          "type": "markdown",
          "value": "Blocks stack up inside a node.\n\n> Anything the app does not recognise is kept as-is on save.",
          "label": "notes",
          "meta": {}
        },
        {
