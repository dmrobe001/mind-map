{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mind-map",
  "version": "0.1.0",
  "identifier": "com.dmrobe001.mindmap",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": "npm run stage"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mind-map",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Mind map editor",
    "longDescription": "A mind map editor for things that refuse to live in one folder."
  }
}
